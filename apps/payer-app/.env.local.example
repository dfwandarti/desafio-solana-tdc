# Copy to .env.local and adjust as needed.
# Defaults to https://api.devnet.solana.com if unset.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Server-only: path to the keypair the app uses to sign every payment on the citizen's
# behalf, so the UI never shows wallet-connect UX. Never NEXT_PUBLIC_-prefixed.
PAYER_KEYPAIR_PATH=/absolute/path/to/keypair.json
