# Copy to .env.local and adjust as needed.
# Defaults to https://api.devnet.solana.com if unset.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Server-only: the keypair that signs every payment on the citizen's behalf, so the UI
# never shows wallet-connect UX. Never NEXT_PUBLIC_-prefixed. Set exactly one of these:

# Local dev: path to a keypair file on disk.
PAYER_KEYPAIR_PATH=/absolute/path/to/keypair.json

# Serverless hosts (Vercel etc.) with no local filesystem: inline the secret key JSON
# array instead, e.g. the literal contents of a solana-keygen file: [12,34,56,...]
# PAYER_KEYPAIR_SECRET=[...]
